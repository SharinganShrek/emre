{
  "manifest_version": 3,
  "name": "SAT Module Builder 1.9 Safari",
  "version": "1.9.0",
  "description": "Standalone Safari build. Timed SAT R&W or Math mocks from the College Board question bank. Finished results are saved inside the HTML file.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mypractice.collegeboard.org/*",
    "https://digitalpractice-api.collegeboard.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAT Module Builder"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mypractice.collegeboard.org/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mypractice.collegeboard.org/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
