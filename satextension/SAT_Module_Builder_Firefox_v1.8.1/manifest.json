{
  "manifest_version": 3,
  "name": "SAT Module Builder 1.8.1 Firefox",
  "version": "1.8.1",
  "description": "Firefox build. Builds timed SAT R&W or Math QBank mocks and imports official Bluebook practice tests into Emre OS.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sat-module-builder@emre.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "host_permissions": [
    "https://mypractice.collegeboard.org/*",
    "https://digitalpractice-api.collegeboard.org/*",
    "https://emre-xi.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["mathml.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAT Module Builder"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mypractice.collegeboard.org/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mypractice.collegeboard.org/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
