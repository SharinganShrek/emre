# =============================================================================
# Emre environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
#
# Without NEXT_PUBLIC_SUPABASE_* the app uses local mock data.
# With URL + SERVICE_ROLE, hub tables sync via /api/hub (Phase 1+2).
# College counseling uses /api/college-counseling (needs phase2_schema.sql).
# APP_PASSWORD gates the whole app (no Supabase Auth).

# --- App password gate (server only) ----------------------------------------
# Leave empty to disable the unlock screen. Set any string to require it.
APP_PASSWORD=

# --- Supabase (public URL/anon) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SERVER ONLY — never expose to the client) --------------------
# Used by /api/hub and AI routes. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI assistant API (required for /api/ai/* routes) -----------------------
# Bearer token the assistant sends as: Authorization: Bearer <AI_API_KEY>
AI_API_KEY=generate-a-long-random-secret
