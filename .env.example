# =============================================================================
# Emre environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
#
# NOTE: The app runs fully WITHOUT Supabase using in-browser seed data.
# Supabase + AI values are only needed when you want real persistence and the
# AI API routes.

# --- Supabase (public, safe for the browser) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SERVER ONLY — never expose to the client) --------------------
# Bypasses Row Level Security. Used exclusively by the AI permission layer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI assistant API -------------------------------------------------------
# Shared secret the assistant sends as `Authorization: Bearer <AI_API_KEY>`.
AI_API_KEY=generate-a-long-random-secret
# The single user id the AI assistant is allowed to act on (MVP is single-user).
AI_USER_ID=00000000-0000-0000-0000-000000000000
